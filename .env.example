# --- Danu Perfume Environment Variables ---

# Neon.tech PostgreSQL connection string
# Example: postgresql://username:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/danu_perfume?sslmode=require
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/danu_perfume?sslmode=require

# Flask secret key (used for sessions, CSRF, login)
SECRET_KEY=change-this-to-a-long-random-secret-string

# Folder (relative to /static) where uploaded images and receipts are stored
UPLOAD_FOLDER=static/uploads

# Max upload size in MB
MAX_UPLOAD_MB=5

# Optional Cloudinary media storage credentials.
# If provided, uploaded images will be stored in Cloudinary.
# Example: CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default admin accounts created on first run (usernames are fixed: Danuta, Tofik)
# Change these passwords immediately after first login in production.
ADMIN_PASSWORD_DANUTA=#Danu1122
ADMIN_PASSWORD_TOFIK=#Danu1122

# Delivery fee random range (ETB) offered to admin when approving an order
DELIVERY_FEE_MIN=80
DELIVERY_FEE_MAX=250

# Multi-currency display rates (informational only — checkout always charges in ETB)
FX_RATE_USD=0.0075
FX_RATE_EUR=0.0069

# Loyalty points earned per 100 ETB spent
LOYALTY_POINTS_PER_100_ETB=5

# Fraud/risk scoring thresholds
RISK_HIGH_ORDER_AMOUNT=5000
RISK_DUPLICATE_WINDOW_MINUTES=30

# Flask environment
FLASK_ENV=production
FLASK_DEBUG=False
